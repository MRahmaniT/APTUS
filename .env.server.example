# Copy to .env.server before running Docker Compose.
# Use a long random password and do not commit the real value.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public website/API port. Put a TLS reverse proxy in front of this in production.
APTUS_PORT=3000

# Optional localhost-only Adminer port (enabled with the "tools" profile).
ADMINER_PORT=8080

# Server tuning.
DATABASE_POOL_SIZE=10
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=100


# Optional passwordless delivery adapters. HTTPS endpoints, server-side credentials only.
OTP_SECRET=
OTP_EMAIL_WEBHOOK_URL=
OTP_EMAIL_WEBHOOK_TOKEN=
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
