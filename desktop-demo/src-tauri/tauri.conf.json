{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APTUS Demo",
  "version": "1.0.0",
  "identifier": "az.aptus.demo",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "APTUS Demo",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "APTUS",
    "shortDescription": "Offline desktop demonstration of the APTUS website",
    "longDescription": "A self-contained desktop demonstration of the APTUS website for client review. It runs locally without Docker, Node.js, PostgreSQL, or an internet connection.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
