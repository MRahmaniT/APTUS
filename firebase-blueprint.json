{
  "rules": [
    {
      "path": "/users/{userId}",
      "read": "request.auth != null && request.auth.uid == userId",
      "write": "false"
    },
    {
      "path": "/admins/{userId}",
      "read": "request.auth != null && request.auth.uid == userId",
      "write": "false"
    },
    {
      "path": "/analytics/{date}",
      "read": "request.auth != null",
      "write": "true"
    },
    {
      "path": "/cms/{docId}",
      "read": "true",
      "write": "request.auth != null"
    }
  ]
}
